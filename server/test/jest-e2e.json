{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "setupFiles": ["<rootDir>/test/jest-setup.js"],
  "globalSetup": "<rootDir>/test/global-setup.js",
  "testTimeout": 30000
}
